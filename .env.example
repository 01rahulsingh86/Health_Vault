# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=production
# Persistent storage for SQLite DB and encrypted uploads. In Docker/Render, mount a volume here.
DATA_DIR=/data
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -base64 32   (encrypts stored files; losing it makes files unreadable — back it up!)
ENC_KEY=
# From console.anthropic.com. Leave empty to disable AI (manual entry still works).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to false after you've created your account(s) to close sign-ups
ALLOW_REGISTRATION=true
# Behind HTTPS proxy: keep defaults. Plain http on localhost testing: COOKIE_SECURE=false
# COOKIE_SECURE=false
MAX_UPLOAD_MB=15
# Freemium SaaS settings
FREE_RECORD_LIMIT=3
FREE_AI_LIMIT=5
PRO_UPGRADE_CODE=pro-demo-2026
# Public deployment gating: set to required to ask for a site-wide key before login/register.
PUBLIC_ACCESS_MODE=off
PUBLIC_ACCESS_KEY=
